{
  "id": "modl-metadata-form",
  "label": "MODL Dataset Metadata Form",
  "description": "Form for capturing MODL Dataset Metadata",
  "wizard_steps": [
    {
      "id": "basic-info",
      "label": "Basic Information",
      "description": "Essential dataset identification",
      "fields": [
        {
          "prop": "title",
          "type": "text",
          "label": "Dataset Title",
          "description": "Unique dataset identifier in ERDDAP",
          "required": true,
          "placeholder": "e.g., South Fork Wind SFW01, Timeseries Data"
        },
        {
          "prop": "id",
          "type": "text",
          "label": "Platform/Station ID",
          "description": "Unique Platform/Station ID",
          "required": true,
          "placeholder": "e.g., SFW01"
        },
        {
          "prop": "platform_name",
          "type": "text",
          "label": "Platform Name",
          "description": "Project or individual platform",
          "placeholder": "e.g., South Fork Wind"
        },
        {
          "prop": "project",
          "type": "text",
          "label": "Project",
          "description": "Name of wind project",
          "placeholder": "e.g., South Fork Wind"
        },
        {
          "prop": "summary",
          "type": "long_text",
          "label": "Summary",
          "description": "Basic summary of dataset - location, platform, variables collected",
          "placeholder": "Describe the dataset, location, platform, and variables collected"
        }
      ]
    },
    {
      "id": "creator-info",
      "label": "Creator Information",
      "description": "Owner/operator of platform details",
      "fields": [
        {
          "prop": "creator_name",
          "type": "text",
          "label": "Creator Name",
          "description": "Name of creator entity",
          "placeholder": "e.g., South Fork Wind"
        },
        {
          "prop": "institution",
          "type": "text",
          "label": "Institution",
          "description": "Institution name",
          "placeholder": "e.g., South Fork Wind - a partnership between Ørsted and Global Infrastructure Partners"
        },
        {
          "prop": "creator_address",
          "type": "text",
          "label": "Creator Address",
          "description": "Mailing address",
          "placeholder": "e.g., 524 Montauk Hwy, Amagansett, NY 11930"
        },
        {
          "prop": "creator_state",
          "type": "text",
          "label": "Creator State",
          "description": "State of operation",
          "placeholder": "e.g., New York"
        },
        {
          "prop": "creator_country",
          "type": "text",
          "label": "Creator Country",
          "description": "Creator country",
          "placeholder": "e.g., USA"
        },
        {
          "prop": "creator_email",
          "type": "text",
          "label": "Creator Email",
          "description": "Primary contact email",
          "placeholder": "e.g., info@southforkwind.com"
        },
        {
          "prop": "creator_URL",
          "type": "text",
          "label": "Creator Website",
          "description": "Creator website URL",
          "placeholder": "e.g., https://southforkwind.com"
        },
        {
          "prop": "creator_sector",
          "type": "select",
          "label": "Creator Sector",
          "description": "IOOS classifier for sector",
          "options": [
            { "label": "State Government", "value": "gov_state" },
            { "label": "Nonprofit", "value": "nonprofit" },
            { "label": "Industry", "value": "industry" },
            { "label": "Academic", "value": "academic" },
            { "label": "Federal Government", "value": "gov_federal" },
            { "label": "Tribal", "value": "tribal" }
          ]
        }
      ]
    },
    {
      "id": "contributor-info",
      "label": "Contributor Information",
      "description": "Platform deployment/data provider entity details",
      "fields": [
        {
          "prop": "contributor_name",
          "type": "text",
          "label": "Contributor Name",
          "description": "Platform deployment/data provider entity",
          "placeholder": "e.g., Woods Hole Group"
        },
        {
          "prop": "contributor_address",
          "type": "text",
          "label": "Contributor Address",
          "description": "Physical address or city/state/country",
          "placeholder": "e.g., 107 Waterhouse Rd, Bourne, MA 02532"
        },
        {
          "prop": "contributor_email",
          "type": "text",
          "label": "Contributor Email",
          "description": "Contributor primary contact email",
          "placeholder": "e.g., dwalsh@woodsholegroup.com"
        },
        {
          "prop": "contributor_url",
          "type": "text",
          "label": "Contributor Website",
          "description": "Contributor website URL",
          "placeholder": "e.g., https://www.woodsholegroup.com/"
        }
      ]
    },
    {
      "id": "publisher-info",
      "label": "Publisher Information",
      "description": "Data management at NERACOOS/MARACOOS",
      "fields": [
        {
          "prop": "publisher_name",
          "type": "text",
          "label": "Publisher Name",
          "description": "Publisher refers to data management at NERACOOS/MARACOOS",
          "placeholder": "e.g., MARACOOS, NERACOOS"
        },
        {
          "prop": "publisher_institution",
          "type": "text",
          "label": "Publisher Institution",
          "description": "Publisher refers to data management at NERACOOS/MARACOOS",
          "placeholder": "e.g., MARACOOS, NERACOOS"
        },
        {
          "prop": "publisher_email",
          "type": "text",
          "label": "Publisher Email",
          "description": "Publisher contact email",
          "placeholder": "e.g., devops@rpsgroup.com, info@neracoos.org"
        },
        {
          "prop": "publisher_phone",
          "type": "text",
          "label": "Publisher Phone",
          "description": "Publisher contact phone",
          "placeholder": "e.g., (401) 789-6224, (603) 319-1785"
        },
        {
          "prop": "publisher_country",
          "type": "text",
          "label": "Publisher Country",
          "description": "Publisher country",
          "placeholder": "e.g., USA"
        },
        {
          "prop": "publisher_url",
          "type": "text",
          "label": "Publisher Website",
          "description": "Publisher website URL",
          "placeholder": "e.g., https://www.maracoos.org, https://www.neracoos.org"
        },
        {
          "prop": "publisher_type",
          "type": "text",
          "label": "Publisher Type",
          "description": "Type of publisher",
          "placeholder": "e.g., institution"
        }
      ]
    },
    {
      "id": "geospatial-info",
      "label": "Geospatial Information",
      "description": "Geographic coordinates",
      "fields": [
        {
          "prop": "geospatial_lat_min",
          "type": "number",
          "label": "Minimum Latitude",
          "description": "Minimum latitude in decimal degrees",
          "placeholder": "e.g., 41.0775"
        },
        {
          "prop": "geospatial_lat_max",
          "type": "number",
          "label": "Maximum Latitude",
          "description": "Maximum latitude in decimal degrees",
          "placeholder": "e.g., 41.0775"
        },
        {
          "prop": "geospatial_lon_min",
          "type": "number",
          "label": "Minimum Longitude",
          "description": "Minimum longitude in decimal degrees",
          "placeholder": "e.g., -71.1855"
        },
        {
          "prop": "geospatial_lon_max",
          "type": "number",
          "label": "Maximum Longitude",
          "description": "Maximum longitude in decimal degrees",
          "placeholder": "e.g., -71.1855"
        }
      ]
    },
    {
      "id": "additional-info",
      "label": "Additional Information",
      "description": "Supplementary metadata",
      "fields": [
        {
          "prop": "comment",
          "type": "long_text",
          "label": "Comment",
          "description": "Description of the buoy/platform and contributor",
          "placeholder": "e.g., South Fork Wind Lidar buoy developed and deployed by Woods Hole Group"
        },
        {
          "prop": "acknowledgement",
          "type": "long_text",
          "label": "Acknowledgement",
          "description": "Acknowledgment of financial supporting entities or award numbers",
          "placeholder": "e.g., This dataset is part of a MetOcean Cyberinfrastructure..."
        },
        {
          "prop": "infoURL",
          "type": "text",
          "label": "Information URL",
          "description": "Best website for information about program",
          "placeholder": "e.g., https://southforkwind.com"
        },
        {
          "prop": "license",
          "type": "long_text",
          "label": "License",
          "description": "General license language for re-use/access of data",
          "placeholder": "e.g., The data may be used and redistributed for free..."
        },
        {
          "prop": "processing_level",
          "type": "text",
          "label": "Processing Level",
          "description": "Processing level of data (raw, qc, level 1, etc)",
          "placeholder": "e.g., raw dataset, no qc provided"
        },
        {
          "prop": "Instrument",
          "type": "text",
          "label": "Instrument(s)",
          "description": "Instruments used (separate by comma if multiple)",
          "placeholder": "e.g., Campbell Scientific MetSENS 500, Garmin GPS16X-HVS"
        }
      ]
    }
  ]
}
