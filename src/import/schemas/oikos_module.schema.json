    "metadata_url": { "type": ["string", "null"] },
    "start_time_utc": { "type": ["number", "null"] },
    "end_time_utc": { "type": ["number", "null"] },
    "min_lng": { "type": "number" },
    "min_lat": { "type": "number" },
    "max_lng": { "type": "number" },
    "max_lat": { "type": "number" },
    "import_tag": { "type": ["string", "null"] },
    "uuid": { "type": "string" },
    "enabled": { "type": "boolean" },
    "searchable": { "type": "boolean" },
    "short_description": { "type": ["string", "null"] },
    "usage_notes": { "type": ["string", "null"] },
    "generated": { "type": "boolean" },
